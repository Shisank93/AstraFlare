# AstraFlare System Environment Configuration

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=astraflare_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=astraflare

# FastAPI Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# NASA FIRMS API Credentials
# Obtain MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE
NASA_FIRMS_DEFAULT_SOURCE=VIIRS_SNPP_NRT
NASA_FIRMS_DEFAULT_AREA=India

# OpenStreetMap / Overpass API Configuration
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_SEARCH_RADIUS_KM=5.0

# ESA WorldCover Data Source
ESA_WORLDCOVER_DATA_DIR=./data/landcover

# ML Model Configuration
MODEL_TYPE=lightgbm
MODEL_ARTIFACT_PATH=./ml/models/astraflare_classifier_v1.pkl
CONFIDENCE_ABSTENTION_THRESHOLD=0.65
RISK_HIGH_THRESHOLD=0.75
